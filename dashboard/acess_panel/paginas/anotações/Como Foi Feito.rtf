<?php\par
class Usuarios\{\par
    private $pdo; \par
    public $msgERRO = "";\par
    public function conectar($nome, $host, $usuario, $senha)\{\par
        global $pdo;\par
        global $msgERRO;\par
        try\{\par
            $pdo = new PDO("mysql:dbname=".$nome.";host=".$host,$usuario,$senha);\par
        \}\par
        catch (PDOException $e)\{\par
            $msgERRO = $e->getMessage();\par
        \}\par
    \}\par
    public function cadastrar($nome, $telefone, $email, $senha)\{        \par
        global $pdo;\par
        $sql = $pdo->prepare("SELECT id_usuario FROM usuarios WHERE email = :e");\par
        $sql-> bindValue(":e", $email);\par
        $sql-> execute();\par
        if ($sql->rowCount()>0):       \par
            return false;      \par
        else:\par
        $sql = $pdo->prepare("INSERT INTO usuarios (nome, telefone, email, senha) VALUES (:n, :t, :e, :s)");\par
        $sql-> bindValue(":n", $nome);\par
        $sql-> bindValue(":t", $telefone);\par
        $sql-> bindValue(":e", $email);\par
        $sql-> bindValue(":s", md5($senha));\par
        $sql->execute();\par
        return true;\par
        endif;\par
    \}\par
    public function logar($email, $senha)\{\par
        global $pdo;\par
        $sql= $pdo->prepare("SELECT id_usuario FROM usuarios WHERE email = :e AND senha = :s");\par
$pdo = new PDO("mysql:dbname=projeto_login;host=localhost", "root", "");\par
        $sql-> bindValue(":e", $email);\par
        $sql-> bindValue(":s", md5($senha));\par
        $sql-> execute();\par
        if($sql->rowCount()>0):\par
            $dado = $sql->fetch();\par
            session_start();\par
            $_SESSION['id_usuario'] = $dado['id_usuario'];\par
            return true; //logado com Sucesso\par
        else:\par
            return false;\par
        endif;\par
    \}\par
\}\par
?>\par
